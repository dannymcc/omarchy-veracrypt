#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${VERACRYPT_VAULTS_CONFIG:-$HOME/.config/omarchy/veracrypt-vaults.tsv}"
SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"

usage() {
  cat <<'EOF'
Usage:
  veracrypt-vaults list
  veracrypt-vaults status
  veracrypt-vaults mount <name>
  veracrypt-vaults unmount <name>
  veracrypt-vaults open <name>
  veracrypt-vaults add <name> <container> <mount_directory>
  veracrypt-vaults remove <name>
  veracrypt-vaults mount-all
  veracrypt-vaults unmount-all
  veracrypt-vaults browse <directory> [files|dirs]
  veracrypt-vaults mkdir <parent> <name>
  veracrypt-vaults config

Config:
  ~/.config/omarchy/veracrypt-vaults.tsv
  name<TAB>container_path<TAB>mount_directory
EOF
}

json_escape() {
  local value="${1-}"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '%s' "$value"
}

die_json() {
  printf '{"ok":false,"error":"%s"}\n' "$(json_escape "$1")"
  exit "${2:-1}"
}

plural() {
  (( $1 == 1 )) && printf 'vault' || printf 'vaults'
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

expand_path() {
  local path="${1-}"
  case "$path" in
    "~") path="$HOME" ;;
    "~/"*) path="$HOME/${path#\~/}" ;;
  esac
  printf '%s' "$path"
}

# Fields are tab-separated, one vault per line, so a tab or newline in a value
# would write a row that reads back as something else. A leading # would read
# back as a comment.
validate_field() {
  local label="$1" value="$2"
  [[ -n "$value" ]] || die_json "$label is required"
  [[ "$value" != *$'\t'* && "$value" != *$'\n'* && "$value" != *$'\r'* ]] \
    || die_json "$label cannot contain tabs or newlines"
}

ensure_config() {
  [[ -f "$CONFIG_FILE" ]] || die_json "Missing config: $CONFIG_FILE"
}

ensure_veracrypt() {
  have_cmd veracrypt || die_json "veracrypt is not installed or not on PATH"
}

# Arch ships both a GUI build and veracrypt-console-bin. The console build
# asks for the passphrase on a terminal, and a click on the bar has nowhere to
# type one, so the mount is handed to a terminal window instead.
has_gui() {
  [[ "${VERACRYPT_VAULTS_TEXT:-0}" == "1" ]] && return 1
  local bin
  bin="$(command -v veracrypt)" || return 1
  ldd "$bin" 2>/dev/null | grep -qi "libwx_"
}

has_terminal() {
  [[ -t 0 && -t 1 ]]
}

# Dismounting needs no passphrase, only root, so it never needs a terminal.
# The escalation goes, in order:
#
#   1. VeraCrypt's own sudo, if it is still authenticated. --use-dummy-sudo-password
#      is VeraCrypt's documented way to try that without prompting anyone, so a
#      cached session unmounts silently.
#   2. polkit, which asks for the admin password in Omarchy's own dialog.
#   3. a terminal, only where there is no polkit agent to ask.
#
# Whatever happens, the result comes back here, so the panel can report it.
DISMOUNT_ERROR=""

last_line() {
  printf '%s' "${1-}" | grep -v '^[[:space:]]*$' | tail -n 1
}

dismount_with_cached_auth() {
  # Bounded: a probe that is meant never to prompt must never hang either.
  timeout 20 veracrypt --text --non-interactive --use-dummy-sudo-password \
    --dismount "$1" 2>&1 </dev/null
}

# VeraCrypt answers some dismounts definitively, with no privilege involved.
# Escalating those would ask for an admin password to be told again that the
# volume is not mounted, or that something still has it open.
is_final_answer() {
  local text="${1-}"
  [[ "$text" == *"No such volume"* || "$text" == *"not mounted"* \
    || "$text" == *"in use"* || "$text" == *busy* ]]
}

have_polkit_agent() {
  have_cmd pkexec && [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]
}

try_dismount() {
  local mountpoint="$1" out rc
  DISMOUNT_ERROR=""

  rc=0
  out="$(dismount_with_cached_auth "$mountpoint")" || rc=$?
  (( rc == 0 )) && return 0
  local cached_error
  cached_error="$(last_line "$out")"

  if is_final_answer "$cached_error"; then
    DISMOUNT_ERROR="$cached_error"
    return 1
  fi

  if ! have_polkit_agent; then
    DISMOUNT_ERROR="${cached_error:-veracrypt could not unmount it}"
    return 1
  fi

  rc=0
  # Long timeout: someone has to read a dialog and type a password.
  out="$(timeout 180 pkexec veracrypt --text --non-interactive \
    --dismount "$mountpoint" 2>&1 </dev/null)" || rc=$?
  (( rc == 0 )) && return 0
  # 126 is the polkit dialog being dismissed or the authentication failing,
  # and 127 is pkexec failing to start. Neither is VeraCrypt's fault, and
  # neither of their messages says anything useful.
  if (( rc == 126 )); then
    DISMOUNT_ERROR="Unmount needs the admin password"
  elif (( rc == 127 )); then
    DISMOUNT_ERROR="Could not ask for the admin password"
  else
    DISMOUNT_ERROR="$(last_line "$out")"
  fi

  [[ -n "$DISMOUNT_ERROR" ]] || DISMOUNT_ERROR="veracrypt could not unmount it"
  return 1
}

# Without a polkit agent there is nowhere graphical to ask for the admin
# password, so a terminal is the only place left.
needs_terminal() {
  ! have_polkit_agent
}

# Re-run ourselves in a terminal, where VeraCrypt can ask for the passphrase
# and sudo can ask for a password. Neither one passes through the plugin.
relaunch_in_terminal() {
  local quoted
  quoted="$(printf '%q ' "$SELF" "$@")"
  if have_cmd omarchy-launch-floating-terminal-with-presentation; then
    setsid omarchy-launch-floating-terminal-with-presentation "$quoted" >/dev/null 2>&1 &
  elif have_cmd xdg-terminal-exec; then
    setsid xdg-terminal-exec -- "$SELF" "$@" >/dev/null 2>&1 &
  else
    die_json "No terminal available to ask for the passphrase"
  fi
  disown 2>/dev/null || true
}

read_vaults() {
  while IFS=$'\t' read -r name container mountpoint extra || [[ -n "${name:-}" ]]; do
    [[ -z "${name:-}" || "${name:0:1}" == "#" ]] && continue
    [[ -n "${container:-}" && -n "${mountpoint:-}" && -z "${extra:-}" ]] || continue
    printf '%s\t%s\t%s\n' "$name" "$container" "$mountpoint"
  done < "$CONFIG_FILE"
}

vault_by_name() {
  local wanted="$1"
  local name container mountpoint
  while IFS=$'\t' read -r name container mountpoint; do
    if [[ "$name" == "$wanted" ]]; then
      printf '%s\t%s\t%s\n' "$name" "$container" "$mountpoint"
      return 0
    fi
  done < <(read_vaults)
  return 1
}

is_mounted() {
  local mountpoint="${1-}"
  [[ -n "$mountpoint" ]] || return 1
  findmnt -M "$mountpoint" >/dev/null 2>&1
}

mounted_path_for() {
  local container="$1"
  local line
  line="$(veracrypt --text --list 2>/dev/null | awk -v c="$container" 'index($0, c) { print; exit }' || true)"
  [[ -n "$line" ]]
}

emit_status() {
  ensure_veracrypt
  local configured=false
  [[ -f "$CONFIG_FILE" ]] && configured=true
  local first=true
  local mounted_count=0
  local total_count=0
  local rows=()
  local name container mountpoint mounted exists

  while IFS=$'\t' read -r name container mountpoint; do
    total_count=$((total_count + 1))
    mounted=false
    if is_mounted "$mountpoint" || mounted_path_for "$container"; then
      mounted=true
      mounted_count=$((mounted_count + 1))
    fi
    exists=false
    [[ -e "$container" ]] && exists=true
    rows+=("{\"name\":\"$(json_escape "$name")\",\"container\":\"$(json_escape "$container")\",\"mountPoint\":\"$(json_escape "$mountpoint")\",\"mounted\":$mounted,\"containerExists\":$exists}")
  done < <([[ "$configured" == true ]] && read_vaults)

  printf '{"ok":true,"configured":%s,"configPath":"%s","mounted":%d,"total":%d,"vaults":[' \
    "$configured" "$(json_escape "$CONFIG_FILE")" "$mounted_count" "$total_count"
  for row in ${rows[@]+"${rows[@]}"}; do
    if [[ "$first" == true ]]; then
      first=false
    else
      printf ','
    fi
    printf '%s' "$row"
  done
  printf ']}\n'
}

emit_list() {
  local first=true
  printf '{"ok":true,"vaults":['
  local name container mountpoint
  while IFS=$'\t' read -r name container mountpoint; do
    if [[ "$first" == true ]]; then
      first=false
    else
      printf ','
    fi
    printf '{"name":"%s","container":"%s","mountPoint":"%s"}' \
      "$(json_escape "$name")" "$(json_escape "$container")" "$(json_escape "$mountpoint")"
  done < <(read_vaults)
  printf ']}\n'
}

add_vault() {
  local name container mountpoint
  name="$1"
  container="$(expand_path "$2")"
  mountpoint="$(expand_path "$3")"

  validate_field "Name" "$name"
  validate_field "Container path" "$container"
  validate_field "Mount directory" "$mountpoint"
  [[ "${name:0:1}" != "#" ]] || die_json "Name cannot start with #"
  [[ "${container:0:1}" == "/" ]] || die_json "Container path must be absolute"
  [[ "${mountpoint:0:1}" == "/" ]] || die_json "Mount directory must be absolute"

  if [[ -f "$CONFIG_FILE" ]] && vault_by_name "$name" >/dev/null 2>&1; then
    die_json "A vault named $name already exists"
  fi

  mkdir -p "$(dirname -- "$CONFIG_FILE")"
  if [[ ! -f "$CONFIG_FILE" ]]; then
    {
      printf '# VeraCrypt vaults for the Omarchy bar widget.\n'
      printf '# One vault per line: name<TAB>container_path<TAB>mount_directory\n'
    } > "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
  fi
  # A config that lost its trailing newline would glue the new row onto the
  # last one.
  [[ -s "$CONFIG_FILE" && -n "$(tail -c 1 "$CONFIG_FILE")" ]] && printf '\n' >> "$CONFIG_FILE"
  printf '%s\t%s\t%s\n' "$name" "$container" "$mountpoint" >> "$CONFIG_FILE"
  printf '{"ok":true,"message":"Added %s","name":"%s"}\n' \
    "$(json_escape "$name")" "$(json_escape "$name")"
}

remove_vault() {
  local name="$1"
  validate_field "Name" "$name"
  vault_by_name "$name" >/dev/null 2>&1 || die_json "Unknown vault: $name"

  local record container mountpoint discard
  record="$(vault_by_name "$name")"
  IFS=$'\t' read -r discard container mountpoint <<< "$record"
  if is_mounted "$mountpoint" || mounted_path_for "$container"; then
    die_json "Unmount $name before removing it"
  fi

  local tmp
  tmp="$(mktemp "${CONFIG_FILE}.XXXXXX")"
  # Keep comments and blank lines; drop only the row that owns this name.
  awk -F'\t' -v target="$name" '$1 != target' "$CONFIG_FILE" > "$tmp"
  chmod --reference="$CONFIG_FILE" "$tmp" 2>/dev/null || chmod 600 "$tmp"
  mv "$tmp" "$CONFIG_FILE"
  printf '{"ok":true,"message":"Removed %s","name":"%s"}\n' \
    "$(json_escape "$name")" "$(json_escape "$name")"
}

# Directory listing for the panel's built-in file picker. An external chooser
# is no use: the panel dismisses on any click outside it, so a GTK dialog takes
# the panel down with it before it can hand a path back.
emit_browse() {
  local dir mode
  dir="$(expand_path "${1:-$HOME}")"
  mode="${2:-files}"
  [[ -d "$dir" ]] || dir="$HOME"
  # Resolve, so ".." does not accumulate in the breadcrumb.
  dir="$(cd -- "$dir" 2>/dev/null && pwd -P)" || die_json "Cannot read directory"

  local parent
  parent="$(dirname -- "$dir")"
  [[ "$parent" == "$dir" ]] && parent=""

  local rows=() entry base isdir likely ext
  while IFS= read -r entry; do
    base="${entry##*/}"
    [[ "${base:0:1}" == "." ]] && continue
    likely=false
    if [[ -d "$entry" ]]; then
      isdir=true
    else
      isdir=false
      [[ "$mode" == "dirs" ]] && continue
      # A container has no magic bytes by design -- the header is encrypted --
      # so the extension is the only hint there is. These are the ones
      # VeraCrypt and TrueCrypt hand out by default.
      ext="${base##*.}"
      [[ "$ext" != "$base" ]] && case "${ext,,}" in
        hc|tc|vc|veracrypt|truecrypt) likely=true ;;
      esac
    fi
    rows+=("{\"name\":\"$(json_escape "$base")\",\"path\":\"$(json_escape "$entry")\",\"dir\":$isdir,\"likely\":$likely}")
  done < <(find "$dir" -mindepth 1 -maxdepth 1 \( -type d -o -type f \) 2>/dev/null | sort -f)

  local first=true
  printf '{"ok":true,"path":"%s","parent":"%s","entries":[' \
    "$(json_escape "$dir")" "$(json_escape "$parent")"
  for row in ${rows[@]+"${rows[@]}"}; do
    if [[ "$first" == true ]]; then first=false; else printf ','; fi
    printf '%s' "$row"
  done
  printf ']}\n'
}

# Mount directories usually do not exist yet, so the picker can make one rather
# than sending someone to a terminal for a mkdir.
make_directory() {
  local parent name target
  parent="$(expand_path "$1")"
  name="$2"
  validate_field "Folder name" "$name"
  [[ "$name" != */* ]] || die_json "Folder name cannot contain /"
  [[ "$name" != "." && "$name" != ".." ]] || die_json "Invalid folder name"
  [[ -d "$parent" ]] || die_json "No such directory: $parent"

  target="$parent/$name"
  [[ ! -e "$target" ]] || die_json "$name already exists"
  mkdir -p -- "$target" || die_json "Could not create $target"
  printf '{"ok":true,"message":"Created %s","path":"%s"}\n' \
    "$(json_escape "$name")" "$(json_escape "$target")"
}

mount_vault() {
  ensure_veracrypt
  local record name container mountpoint
  record="$(vault_by_name "$1")" || die_json "Unknown vault: $1"
  IFS=$'\t' read -r name container mountpoint <<< "$record"
  [[ -e "$container" ]] || die_json "Container does not exist: $container"
  mkdir -p "$mountpoint"
  if is_mounted "$mountpoint"; then
    printf '{"ok":true,"message":"Already mounted","name":"%s"}\n' "$(json_escape "$name")"
    return 0
  fi
  if has_gui; then
    # The GUI build asks for the passphrase in its own window.
    setsid veracrypt --mount "$container" "$mountpoint" >/dev/null 2>&1 &
    disown 2>/dev/null || true
    printf '{"ok":true,"message":"VeraCrypt is asking for the passphrase","name":"%s"}\n' \
      "$(json_escape "$name")"
    return 0
  fi
  if ! has_terminal; then
    relaunch_in_terminal mount "$name"
    printf '{"ok":true,"message":"Opened a terminal for the passphrase","name":"%s"}\n' \
      "$(json_escape "$name")"
    return 0
  fi
  veracrypt --text --mount "$container" "$mountpoint"
  printf '{"ok":true,"message":"Mounted","name":"%s"}\n' "$(json_escape "$name")"
}

unmount_vault() {
  ensure_veracrypt
  local record name container mountpoint
  record="$(vault_by_name "$1")" || die_json "Unknown vault: $1"
  IFS=$'\t' read -r name container mountpoint <<< "$record"
  if ! is_mounted "$mountpoint" && ! mounted_path_for "$container"; then
    printf '{"ok":true,"message":"Already unmounted","name":"%s"}\n' "$(json_escape "$name")"
    return 0
  fi
  if try_dismount "$mountpoint"; then
    printf '{"ok":true,"message":"Unmounted","name":"%s"}\n' "$(json_escape "$name")"
    return 0
  fi
  # Only a missing password justifies a terminal, and only where polkit cannot
  # ask for it. Anything else -- a mount something still has open, most often
  # -- is a real answer, and the panel is where it should show up.
  if ! has_terminal && needs_terminal; then
    relaunch_in_terminal unmount "$name"
    printf '{"ok":true,"message":"Opened a terminal to unmount","name":"%s"}\n' \
      "$(json_escape "$name")"
    return 0
  fi
  die_json "$DISMOUNT_ERROR"
}

# Mount everything in the config that is not mounted yet. One terminal for the
# lot, so VeraCrypt asks for each passphrase in the same window and sudo asks
# once rather than once per vault.
mount_all() {
  ensure_veracrypt
  local names=() name container mountpoint
  while IFS=$'\t' read -r name container mountpoint; do
    is_mounted "$mountpoint" || mounted_path_for "$container" || {
      [[ -e "$container" ]] && names+=("$name")
    }
  done < <(read_vaults)

  local count=${#names[@]}
  (( count > 0 )) || { printf '{"ok":true,"message":"Everything is mounted"}\n'; return 0; }

  if ! has_gui && ! has_terminal; then
    relaunch_in_terminal mount-all
    printf '{"ok":true,"message":"Opened a terminal for %d %s"}\n' \
      "$count" "$( (( count == 1 )) && printf 'passphrase' || printf 'passphrases')"
    return 0
  fi

  local failed=0 record
  for name in "${names[@]}"; do
    record="$(vault_by_name "$name")" || { failed=$((failed + 1)); continue; }
    IFS=$'\t' read -r name container mountpoint <<< "$record"
    mkdir -p "$mountpoint"
    if has_gui; then
      setsid veracrypt --mount "$container" "$mountpoint" >/dev/null 2>&1 &
      disown 2>/dev/null || true
    else
      veracrypt --text --mount "$container" "$mountpoint" || failed=$((failed + 1))
    fi
  done

  if (( failed > 0 )); then
    printf '{"ok":false,"error":"Mounted %d of %d %s"}\n' \
      "$((count - failed))" "$count" "$(plural "$count")"
    return 1
  fi
  printf '{"ok":true,"message":"Mounted %d %s"}\n' "$count" "$(plural "$count")"
}

# Unmount everything this config knows to be mounted. Deliberately not
# `veracrypt --dismount` with no argument: that would also take down volumes
# mounted outside the plugin, which are none of its business.
unmount_all() {
  ensure_veracrypt
  local names=() name container mountpoint
  while IFS=$'\t' read -r name container mountpoint; do
    if is_mounted "$mountpoint" || mounted_path_for "$container"; then
      names+=("$name")
    fi
  done < <(read_vaults)

  local count=${#names[@]}
  (( count > 0 )) || { printf '{"ok":true,"message":"Nothing mounted"}\n'; return 0; }

  local failed=0 record last_error=""
  for name in "${names[@]}"; do
    record="$(vault_by_name "$name")" || { failed=$((failed + 1)); continue; }
    IFS=$'\t' read -r name container mountpoint <<< "$record"
    try_dismount "$mountpoint" || { failed=$((failed + 1)); last_error="$DISMOUNT_ERROR"; }
  done

  # One terminal for the lot, and only where polkit cannot do the asking.
  if (( failed > 0 )) && ! has_terminal && needs_terminal; then
    relaunch_in_terminal unmount-all
    printf '{"ok":true,"message":"Opened a terminal to unmount %d %s"}\n' "$count" "$(plural "$count")"
    return 0
  fi

  if (( failed > 0 )); then
    printf '{"ok":false,"error":"Unmounted %d of %d %s: %s"}\n' \
      "$((count - failed))" "$count" "$(plural "$count")" "$(json_escape "$last_error")"
    return 1
  fi
  printf '{"ok":true,"message":"Unmounted %d %s"}\n' "$count" "$(plural "$count")"
}

open_mountpoint() {
  local record name container mountpoint
  record="$(vault_by_name "$1")" || die_json "Unknown vault: $1"
  IFS=$'\t' read -r name container mountpoint <<< "$record"
  [[ -d "$mountpoint" ]] || die_json "Mount point does not exist: $mountpoint"
  if have_cmd xdg-open; then
    xdg-open "$mountpoint" >/dev/null 2>&1 &
    printf '{"ok":true,"message":"Opened","name":"%s"}\n' "$(json_escape "$name")"
  else
    die_json "xdg-open is not installed"
  fi
}

main() {
  local command="${1:-}"
  # status answers without a config file so the panel can offer to make one;
  # everything else needs one to mean anything.
  case "$command" in
    list|mount|unmount|dismount|open|remove|mount-all|unmount-all|dismount-all) ensure_config ;;
  esac

  case "$command" in
    config) printf '{"ok":true,"configPath":"%s","exists":%s}\n' \
      "$(json_escape "$CONFIG_FILE")" "$([[ -f "$CONFIG_FILE" ]] && echo true || echo false)" ;;
    list) emit_list ;;
    status) emit_status ;;
    browse) emit_browse "${2:-}" "${3:-files}" ;;
    mkdir)
      [[ $# -eq 3 ]] || die_json "mkdir requires a parent directory and a name"
      make_directory "$2" "$3"
      ;;
    add)
      [[ $# -eq 4 ]] || die_json "add requires a name, container path and mount directory"
      add_vault "$2" "$3" "$4"
      ;;
    remove|delete)
      [[ $# -eq 2 ]] || die_json "remove requires a vault name"
      remove_vault "$2"
      ;;
    mount)
      [[ $# -eq 2 ]] || die_json "mount requires a vault name"
      mount_vault "$2"
      ;;
    mount-all) mount_all ;;
    unmount-all|dismount-all) unmount_all ;;
    unmount|dismount)
      [[ $# -eq 2 ]] || die_json "unmount requires a vault name"
      unmount_vault "$2"
      ;;
    open)
      [[ $# -eq 2 ]] || die_json "open requires a vault name"
      open_mountpoint "$2"
      ;;
    -h|--help|help|"")
      usage
      ;;
    *)
      die_json "Unknown command: $command"
      ;;
  esac
}

main "$@"
